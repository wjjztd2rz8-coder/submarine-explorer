{
  "name": "submarine-explorer",
  "version": "1.0.0",
  "description": "Web submarine explorer rendering real GMRT ocean-floor bathymetry",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python3 -m unittest discover -s tools/tests -v",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:attribution": "python3 tools/check_attribution.py",
    "ci": "npm run test:py && npm run build && npm test && npm run test:e2e && npm run check:attribution && npm run format:check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
